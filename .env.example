# In Case of — local development environment template.
# Copy to .env and fill in. NEVER commit the filled-in file.
# In deployed environments these come from AWS Secrets Manager, not from a file.

# Google AI Studio key for gemini-3.7-flash. Billed separately from AWS credits.
GEMINI_API_KEY=

# AWS profile used for local development against the dev environment.
AWS_PROFILE=
AWS_REGION=us-east-1

# Environment name: local | dev | demo | staging | prod
ICO_ENV=local

# Demo time compression (see docs/DEMO.md). 1.0 in production. 0.02 for demos.
DEMO_TIME_SCALE=1.0
