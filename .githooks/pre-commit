#!/usr/bin/env bash
# Pre-commit gate.
#
# Fast, high-signal checks only: anything slow belongs in CI, or the hook gets bypassed
# and stops protecting anything. These run against STAGED files.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

FAIL=0

# 1. No environment files, keystores or service-account JSON, ever.
blocked=$(printf '%s\n' "$staged" | grep -E '(^|/)\.env($|\.)|\.(keystore|jks|p12|p8|pem)$|google-services\.json|service-account.*\.json' | grep -v '\.env\.example$' || true)
if [ -n "$blocked" ]; then
  echo "✗ blocked file(s) staged:"
  printf '%s\n' "$blocked" | sed 's/^/    /'
  FAIL=1
fi

# 2. Secrets and real phone numbers in the staged content.
# shellcheck disable=SC2086
if ! printf '%s\n' "$staged" | xargs python3 scripts/check-secrets.py >/dev/null 2>&1; then
  printf '%s\n' "$staged" | xargs python3 scripts/check-secrets.py
  FAIL=1
fi
# shellcheck disable=SC2086
if ! printf '%s\n' "$staged" | xargs python3 scripts/check-phone-numbers.py >/dev/null 2>&1; then
  printf '%s\n' "$staged" | xargs python3 scripts/check-phone-numbers.py
  FAIL=1
fi

# 3. Generated design tokens must match their source.
if printf '%s\n' "$staged" | grep -q 'design-tokens/tokens.json'; then
  if ! npm run tokens:check --silent >/dev/null 2>&1; then
    echo "✗ design tokens: generated files do not match tokens.json"
    echo "    run: npm run tokens   then stage the generated files"
    FAIL=1
  fi
fi

if [ "$FAIL" -ne 0 ]; then
  echo ""
  echo "Commit blocked. Fix the above, or use --no-verify only if you are certain."
  exit 1
fi
exit 0
