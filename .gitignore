# ---- Secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.p8
*.p12
*.keystore
*.jks
google-services.json
service-account*.json
secrets.json

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/

# ---- Node / web ----
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
