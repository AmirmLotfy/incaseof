root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

# @Composable functions are PascalCase by Compose convention; ktlint's function-naming
# rule would otherwise flag every composable in the project.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Backtick-quoted test names are idiomatic and more readable than camelCase in tests.
ktlint_standard_function-naming = enabled

[*.{xml,json,yml,yaml}]
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,css}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100
