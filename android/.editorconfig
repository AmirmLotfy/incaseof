root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

# Declared explicitly rather than relying on the Gradle plugin's android flag, which does
# not reach ktlint's own config resolution.
ktlint_code_style = ktlint_official

# Disabled deliberately. This rule forces every signature with two or more parameters
# onto separate lines, which suits a library API and reads as noise in Compose, where
# two-parameter functions are the norm. Everything else in ktlint_official stays on:
# the alternative, android_studio, disallows trailing commas and would churn every file
# in the opposite direction for no readability gain.
ktlint_standard_function-signature = disabled

# @Composable functions are PascalCase by Compose convention; ktlint's function-naming
# rule would otherwise flag every composable in the project.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Backtick-quoted test names are idiomatic and more readable than camelCase in tests.
ktlint_standard_function-naming = enabled

[*.{xml,json,yml,yaml}]
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,css}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100
